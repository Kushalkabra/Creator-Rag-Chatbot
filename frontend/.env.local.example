# Local dev — call backend directly
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Vercel production (recommended) ---
# Server-only variable for Next.js rewrites (/api/* -> Railway)
# BACKEND_URL=https://creator-rag-api-production.up.railway.app
#
# Do NOT set NEXT_PUBLIC_API_URL to your *.vercel.app URL.
# Optional: force proxy even if a public URL is set
# NEXT_PUBLIC_USE_API_PROXY=true
